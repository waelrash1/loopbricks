{
  "format": "loopbricks-model",
  "version": 1,
  "key": "smooth",
  "title": "Smooth (Information Delay)",
  "description": "Exponential averaging of a noisy or shifting signal: perception lags reality. First-order chases smoothly; higher-order responds in an S-shape.",
  "model": {
    "name": "Smooth",
    "timeUnit": "week",
    "T": 60,
    "dt": 0.1,
    "stocks": [
      { "id": "s1", "name": "First order smooth", "init": "30", "x": 550, "y": 80 },
      { "id": "m1", "name": "Smoothing stage 1", "init": "30", "x": 250, "y": 340 },
      { "id": "m2", "name": "Smoothing stage 2", "init": "30", "x": 400, "y": 340 },
      { "id": "s3", "name": "Third order smooth", "init": "30", "x": 550, "y": 220 }
    ],
    "flows": [
      { "id": "adj1", "name": "Adjust first order", "to": "s1", "eq": "(Input_signal - First_order_smooth) / Smoothing_time", "x": 360, "y": 125 },
      { "id": "adjM1", "name": "Adjust stage 1", "to": "m1", "eq": "(Input_signal - Smoothing_stage_1) / Stage_smoothing_time", "x": 170, "y": 340 },
      { "id": "adjM2", "name": "Adjust stage 2", "to": "m2", "eq": "(Smoothing_stage_1 - Smoothing_stage_2) / Stage_smoothing_time", "x": 325, "y": 400 },
      { "id": "adj3", "name": "Adjust third order", "to": "s3", "eq": "(Smoothing_stage_2 - Third_order_smooth) / Stage_smoothing_time", "x": 360, "y": 175 }
    ],
    "vars": [
      { "id": "target", "name": "Input level", "eq": "70", "x": 80, "y": 510 },
      { "id": "tau", "name": "Smoothing time", "eq": "6", "x": 250, "y": 570 },
      { "id": "st", "name": "Stage smoothing time", "eq": "Smoothing_time / 3", "x": 420, "y": 510 },
      { "id": "input", "name": "Input signal", "eq": "Input_level", "x": 170, "y": 150 }
    ]
  },
  "params": {
    "target": { "min": 0, "max": 100, "step": 1 },
    "tau": { "min": 1, "max": 20, "step": 0.5 }
  },
  "presets": [
    { "label": "Step up", "params": {"target": 80, "tau": 6} },
    { "label": "Slow (τ=15)", "params": {"target": 80, "tau": 15} },
    { "label": "Snappy (τ=2)", "params": {"target": 80, "tau": 2} }
  ]
}
