{
  "format": "loopbricks-model",
  "version": 1,
  "key": "workforceFromBudget",
  "title": "Workforce from Budget (people = budget ÷ average wage)",
  "description": "Divide the workforce budget by the average wage to get the number of people you can afford: the goal that hiring then chases.",
  "model": {
    "name": "Workforce from Budget",
    "timeUnit": "year",
    "T": 60,
    "dt": 0.1,
    "stocks": [
      {
        "id": "workforce",
        "name": "Workforce",
        "init": "20",
        "x": 395,
        "y": 150,
        "nonNegative": true
      }
    ],
    "flows": [
      {
        "id": "hiring",
        "name": "Net hiring",
        "to": "workforce",
        "eq": "(Affordable_workforce - Workforce) / Time_to_adjust_workforce",
        "x": 185,
        "y": 150
      }
    ],
    "vars": [
      {
        "id": "budget",
        "name": "Workforce budget",
        "eq": "3000",
        "x": 80,
        "y": -40
      },
      {
        "id": "avgWage",
        "name": "Average wage",
        "eq": "60",
        "x": 230,
        "y": -40
      },
      {
        "id": "tHire",
        "name": "Time to adjust workforce",
        "eq": "2",
        "x": 380,
        "y": -40
      },
      {
        "id": "desired",
        "name": "Affordable workforce",
        "eq": "Workforce_budget / MAX(1, Average_wage)",
        "x": 80,
        "y": 450
      },
      {
        "id": "spending",
        "name": "Wage bill",
        "eq": "Workforce * Average_wage",
        "x": 230,
        "y": 450
      },
      {
        "id": "desiredDisp",
        "name": "Desired people",
        "eq": "Affordable_workforce",
        "x": 260,
        "y": 320
      }
    ]
  },
  "params": {
    "budget": {
      "min": 500,
      "max": 6000,
      "step": 100
    },
    "avgWage": {
      "min": 30,
      "max": 150,
      "step": 5
    },
    "tHire": {
      "min": 0.5,
      "max": 6,
      "step": 0.5
    }
  },
  "presets": [
    {
      "label": "Can afford 50",
      "params": {
        "budget": 3000,
        "avgWage": 60,
        "tHire": 2
      }
    },
    {
      "label": "Pay rise",
      "params": {
        "budget": 3000,
        "avgWage": 75,
        "tHire": 2
      }
    },
    {
      "label": "Budget cut",
      "params": {
        "budget": 900,
        "avgWage": 60,
        "tHire": 2
      }
    }
  ]
}
