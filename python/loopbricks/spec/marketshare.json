{
  "format": "loopbricks-model",
  "version": 1,
  "key": "marketshare",
  "title": "Market Share (Success to the Successful)",
  "description": "Demand is split by relative attractiveness, and when attractiveness grows with size, the bigger player pulls ahead until it locks in the market.",
  "model": {
    "name": "Market Share",
    "timeUnit": "month",
    "T": 60,
    "dt": 0.1,
    "stocks": [
      { "id": "a", "name": "Product A", "init": "105", "x": 555, "y": 80, "nonNegative": true },
      { "id": "b", "name": "Product B", "init": "95", "x": 555, "y": 220, "nonNegative": true }
    ],
    "flows": [
      { "id": "toA", "name": "Wins to A", "to": "a", "eq": "New_customers * Share_of_A", "x": 300, "y": 115 },
      { "id": "toB", "name": "Wins to B", "to": "b", "eq": "New_customers * (1 - Share_of_A)", "x": 300, "y": 185 },
      { "id": "outA", "name": "Churn A", "from": "a", "eq": "Product_A / Churn_time", "x": 710, "y": 80 },
      { "id": "outB", "name": "Churn B", "from": "b", "eq": "Product_B / Churn_time", "x": 710, "y": 220 }
    ],
    "vars": [
      { "id": "inflow", "name": "New customers", "eq": "20", "x": 80, "y": 330 },
      { "id": "network", "name": "Network effect", "eq": "0.7", "x": 207, "y": 390 },
      { "id": "churn", "name": "Churn time", "eq": "18", "x": 333, "y": 330 },
      { "id": "phi", "name": "Attractiveness exponent", "eq": "1 + 2 * Network_effect", "x": 460, "y": 390 },
      { "id": "wa", "name": "Attractiveness A", "eq": "Product_A ^ Attractiveness_exponent", "x": 587, "y": 330 },
      { "id": "wb", "name": "Attractiveness B", "eq": "Product_B ^ Attractiveness_exponent", "x": 713, "y": 390 },
      { "id": "shareA", "name": "Share of A", "eq": "Attractiveness_A / (Attractiveness_A + Attractiveness_B + 0.000000001)", "x": 840, "y": 330 }
    ]
  },
  "params": {
    "inflow": { "min": 5, "max": 40, "step": 1 },
    "network": { "min": 0, "max": 1, "step": 0.05 },
    "churn": { "min": 4, "max": 36, "step": 1 }
  },
  "presets": [
    { "label": "Lock-in", "params": {"inflow": 20, "network": 0.7, "churn": 18} },
    { "label": "No network effect", "params": {"inflow": 20, "network": 0, "churn": 18} },
    { "label": "Winner takes all", "params": {"inflow": 20, "network": 1, "churn": 18} }
  ]
}
