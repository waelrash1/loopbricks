{
  "format": "loopbricks-model",
  "version": 1,
  "key": "broken",
  "title": "Broken Cascade",
  "description": "A chain where material can leak out mid-stream instead of always advancing: the structure behind funnels and yield loss.",
  "model": {
    "name": "Broken Cascade",
    "timeUnit": "month",
    "T": 60,
    "dt": 0.1,
    "stocks": [
      { "id": "l1", "name": "Stage 1", "init": "80", "x": 205, "y": 125, "nonNegative": true },
      { "id": "l2", "name": "Stage 2", "init": "0", "x": 575, "y": 125, "nonNegative": true }
    ],
    "flows": [
      { "id": "in", "name": "Entering", "to": "l1", "eq": "Inflow", "x": 95, "y": 125 },
      { "id": "fwd", "name": "Advance", "from": "l1", "to": "l2", "eq": "Exiting_stage_1 * (1 - Leak_fraction)", "x": 390, "y": 125 },
      { "id": "leakFlow", "name": "Leaking", "from": "l1", "eq": "Exiting_stage_1 * Leak_fraction", "x": 205, "y": 233 },
      { "id": "out", "name": "Outflow", "from": "l2", "eq": "Stage_2 / Flow_τ", "x": 710, "y": 125 }
    ],
    "vars": [
      { "id": "inflow", "name": "Inflow", "eq": "0", "x": 80, "y": 343 },
      { "id": "tau", "name": "Flow τ", "eq": "4", "x": 250, "y": 403 },
      { "id": "leak", "name": "Leak fraction", "eq": "0.3", "x": 420, "y": 343 },
      { "id": "exit", "name": "Exiting stage 1", "eq": "Stage_1 / Flow_τ", "x": 590, "y": 403 }
    ]
  },
  "params": {
    "inflow": { "min": 0, "max": 20, "step": 0.5 },
    "tau": { "min": 1, "max": 12, "step": 0.5 },
    "leak": { "min": 0, "max": 0.9, "step": 0.02 }
  },
  "presets": [
    { "label": "Low leak", "params": {"inflow": 0, "tau": 4, "leak": 0.1} },
    { "label": "High leak", "params": {"inflow": 0, "tau": 4, "leak": 0.8} }
  ]
}
