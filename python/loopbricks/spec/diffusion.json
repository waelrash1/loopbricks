{
  "format": "loopbricks-model",
  "version": 1,
  "key": "diffusion",
  "title": "Diffusion (Bass / Contagion)",
  "description": "Adoption spreads by two channels: a steady trickle of innovators, plus word-of-mouth where each adopter recruits more, an epidemic of ideas.",
  "model": {
    "name": "Diffusion",
    "timeUnit": "week",
    "T": 60,
    "dt": 0.1,
    "stocks": [
      { "id": "pot", "name": "Potential", "init": "1000", "x": 295, "y": 150, "nonNegative": true },
      { "id": "adopt", "name": "Adopters", "init": "0", "x": 585, "y": 150, "nonNegative": true }
    ],
    "flows": [
      { "id": "adoption", "name": "Adoption", "from": "pot", "to": "adopt", "eq": "(Innovation_p / 100 + Imitation_q / 100 * (Adopters / Total_population)) * Potential", "x": 440, "y": 150 }
    ],
    "vars": [
      { "id": "p", "name": "Innovation p", "eq": "1", "x": 80, "y": 260 },
      { "id": "q", "name": "Imitation q", "eq": "18", "x": 250, "y": 320 },
      { "id": "N", "name": "Total population", "eq": "Potential + Adopters", "x": 420, "y": 260 }
    ]
  },
  "params": {
    "p": { "min": 0, "max": 5, "step": 0.1 },
    "q": { "min": 0, "max": 40, "step": 1 }
  },
  "presets": [
    { "label": "Word-of-mouth", "params": {"p": 1, "q": 18} },
    { "label": "Ad-driven", "params": {"p": 4, "q": 5} },
    { "label": "Viral", "params": {"p": 0.5, "q": 35} }
  ]
}
