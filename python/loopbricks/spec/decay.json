{
  "format": "loopbricks-model",
  "version": 1,
  "key": "decay",
  "title": "Decay (Exponential)",
  "description": "Outflow proportional to the stock itself: the first closed loop. The stock falls fast when full, slowly when nearly empty: exponential decline.",
  "model": {
    "name": "Decay",
    "timeUnit": "year",
    "T": 60,
    "dt": 0.1,
    "stocks": [
      { "id": "q", "name": "Stock", "init": "100", "x": 365, "y": 150, "nonNegative": true }
    ],
    "flows": [
      { "id": "out", "name": "Decay", "from": "q", "eq": "Stock / Decay_time_τ", "x": 608, "y": 150 }
    ],
    "vars": [
      { "id": "tau", "name": "Decay time τ", "eq": "5", "x": 80, "y": 260 }
    ]
  },
  "params": {
    "tau": { "min": 1, "max": 20, "step": 0.5 }
  },
  "presets": [
    { "label": "Fast decay", "params": {"tau": 2} },
    { "label": "Slow decay", "params": {"tau": 15} }
  ]
}
