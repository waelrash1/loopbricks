{
  "format": "loopbricks-model",
  "version": 1,
  "key": "reworkCycle",
  "title": "Rework Cycle (Work Accomplishment)",
  "description": "Work gets done, but a fraction is done wrong, hides as undiscovered rework, and flows back. The reason projects are '90% done' for half their life.",
  "model": {
    "name": "Rework Cycle",
    "timeUnit": "week",
    "T": 60,
    "dt": 0.1,
    "stocks": [
      {
        "id": "workToDo",
        "name": "Work to do",
        "init": "1000",
        "x": 175,
        "y": 140,
        "nonNegative": true
      },
      {
        "id": "undiscovered",
        "name": "Undiscovered rework",
        "init": "0",
        "x": 425,
        "y": 240,
        "nonNegative": true
      },
      {
        "id": "workDone",
        "name": "Work done",
        "init": "0",
        "x": 655,
        "y": 140,
        "nonNegative": true
      }
    ],
    "flows": [
      {
        "id": "correct",
        "name": "Correct work",
        "from": "workToDo",
        "to": "workDone",
        "eq": "Accomplishing * Quality",
        "x": 415,
        "y": 140
      },
      {
        "id": "rework",
        "name": "Creating rework",
        "from": "workToDo",
        "to": "undiscovered",
        "eq": "Accomplishing * (1 - Quality)",
        "x": 243,
        "y": 240
      },
      {
        "id": "discovering",
        "name": "Discovering rework",
        "from": "undiscovered",
        "to": "workToDo",
        "eq": "Undiscovered_rework / Rework_discovery_time",
        "x": 485,
        "y": 110
      }
    ],
    "vars": [
      {
        "id": "capacity",
        "name": "Work capacity",
        "eq": "90",
        "x": 100,
        "y": 370
      },
      {
        "id": "quality",
        "name": "Quality",
        "eq": "0.8",
        "x": 260,
        "y": 370
      },
      {
        "id": "discoverTime",
        "name": "Rework discovery time",
        "eq": "5",
        "x": 420,
        "y": 370
      },
      {
        "id": "accomplishing",
        "name": "Accomplishing",
        "eq": "MIN(Work_capacity, Work_to_do / 0.5)",
        "x": 580,
        "y": 370
      }
    ]
  },
  "params": {
    "capacity": {
      "min": 20,
      "max": 200,
      "step": 5
    },
    "quality": {
      "min": 0.5,
      "max": 1,
      "step": 0.02
    },
    "discoverTime": {
      "min": 1,
      "max": 16,
      "step": 0.5
    }
  },
  "presets": [
    {
      "label": "High quality",
      "params": {
        "capacity": 90,
        "quality": 0.95,
        "discoverTime": 5
      }
    },
    {
      "label": "Low quality (long tail)",
      "params": {
        "capacity": 90,
        "quality": 0.6,
        "discoverTime": 5
      }
    }
  ]
}
