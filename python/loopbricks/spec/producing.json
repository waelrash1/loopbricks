{
  "format": "loopbricks-model",
  "version": 1,
  "key": "producing",
  "title": "Producing (Workers × Productivity)",
  "description": "Workers times their productivity gives what they produce or accomplish. One multiplication, used in almost every model that has people doing work.",
  "model": {
    "name": "Producing",
    "timeUnit": "month",
    "T": 60,
    "dt": 0.1,
    "stocks": [
      {"id":"produced","name":"Drawings produced","init":"0","x":505,"y":150,"nonNegative":true},
      {"id":"rate","name":"Producing rate","init":"Producing","x":560,"y":330,"nonNegative":true}
    ],
    "flows": [
      {"id":"producing","name":"Producing","to":"produced","eq":"Workers * Productivity","x":240,"y":150},
      {"id":"track_rate","name":"Tracking producing rate","to":"rate","eq":"(Producing - Producing_rate) / DT","x":450,"y":330}
    ],
    "vars": [
      {"id":"workers","name":"Workers","eq":"10","units":"people","x":80,"y":420},
      {"id":"productivity","name":"Productivity","eq":"2","units":"/p·month","x":220,"y":420}
    ]
  },
  "params": {
    "workers": {"min":0,"max":30,"step":1},
    "productivity": {"min":0.5,"max":10,"step":0.5}
  },
  "presets": [
    {"label":"10 workers × 2","params":{"workers":10,"productivity":2}},
    {"label":"5 workers × 4 (same output)","params":{"workers":5,"productivity":4}},
    {"label":"Double the team","params":{"workers":20,"productivity":2}}
  ]
}
