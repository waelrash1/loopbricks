{
  "format": "loopbricks-model",
  "version": 1,
  "key": "univariateAnchor",
  "title": "Univariate Anchoring and Adjustment",
  "description": "People rarely work a quantity out from scratch. They start from a known value, the anchor, and adjust it for one piece of information.",
  "model": {
    "name": "Univariate Anchoring and Adjustment",
    "timeUnit": "week",
    "T": 60,
    "dt": 0.1,
    "stocks": [
      {
        "id": "judged",
        "name": "Value in use",
        "init": "100",
        "x": 405,
        "y": 150
      }
    ],
    "flows": [
      {
        "id": "adjusting",
        "name": "Adopting the value",
        "to": "judged",
        "eq": "(Value - Value_in_use) / 2",
        "x": 190,
        "y": 150
      }
    ],
    "vars": [
      {
        "id": "anchor",
        "name": "Anchor",
        "eq": "100",
        "x": 80,
        "y": -40
      },
      {
        "id": "current",
        "name": "Current value of variable",
        "eq": "150",
        "x": 230,
        "y": -40
      },
      {
        "id": "normal",
        "name": "Normal value of variable",
        "eq": "100",
        "x": 380,
        "y": -40
      },
      {
        "id": "strength",
        "name": "Adjustment strength",
        "eq": "0.5",
        "x": 530,
        "y": -40
      },
      {
        "id": "pressure",
        "name": "Pressure",
        "eq": "Current_value_of_variable / Normal_value_of_variable",
        "x": 80,
        "y": 450
      },
      {
        "id": "adjustment",
        "name": "Adjustment",
        "eq": "MAX(Pressure, 1e-6) ^ Adjustment_strength",
        "x": 230,
        "y": 450
      },
      {
        "id": "value",
        "name": "Value",
        "eq": "Anchor * Adjustment",
        "x": 380,
        "y": 450
      },
      {
        "id": "ind",
        "name": "Algebraic value",
        "eq": "Value",
        "x": 260,
        "y": 320
      }
    ]
  },
  "params": {
    "anchor": {
      "min": 20,
      "max": 200,
      "step": 5
    },
    "current": {
      "min": 20,
      "max": 200,
      "step": 5
    },
    "normal": {
      "min": 50,
      "max": 200,
      "step": 5
    },
    "strength": {
      "min": -1,
      "max": 1,
      "step": 0.1
    }
  },
  "presets": [
    {
      "label": "Under-adjust (√)",
      "params": {
        "anchor": 100,
        "current": 150,
        "normal": 100,
        "strength": 0.5
      }
    },
    {
      "label": "Proportional",
      "params": {
        "anchor": 100,
        "current": 150,
        "normal": 100,
        "strength": 1
      }
    },
    {
      "label": "Inverse effect",
      "params": {
        "anchor": 100,
        "current": 150,
        "normal": 100,
        "strength": -1
      }
    }
  ]
}
