{
  "format": "loopbricks-model",
  "version": 1,
  "key": "protLevel",
  "title": "Level Protected by Level",
  "description": "Keep a stock non-negative by multiplying its outflow by a smooth effect that fades to zero as the stock empties: gentler and more accurate than IF-THEN-ELSE.",
  "model": {
    "name": "Level Protected by Level",
    "timeUnit": "week",
    "T": 60,
    "dt": 0.1,
    "stocks": [
      { "id": "level", "name": "Inventory", "init": "100", "x": 395, "y": 150, "nonNegative": true }
    ],
    "flows": [
      { "id": "in", "name": "Replenish", "to": "level", "eq": "Replenishment", "x": 185, "y": 150 },
      { "id": "out", "name": "Draining", "from": "level", "eq": "Desired_draining * Protection_effect", "x": 623, "y": 150 }
    ],
    "vars": [
      { "id": "inflow", "name": "Replenishment", "eq": "4", "x": 80, "y": 260 },
      { "id": "desiredOut", "name": "Desired draining", "eq": "12", "x": 250, "y": 320 },
      { "id": "protectBelow", "name": "Protect below", "eq": "25", "x": 420, "y": 260 },
      { "id": "effect", "name": "Protection effect", "eq": "MAX(0, MIN(1, Inventory / Protect_below))", "x": 590, "y": 320 }
    ]
  },
  "params": {
    "inflow": { "min": 0, "max": 15, "step": 0.5 },
    "desiredOut": { "min": 0, "max": 25, "step": 0.5 },
    "protectBelow": { "min": 5, "max": 60, "step": 1 }
  },
  "presets": [
    { "label": "Demand > supply", "params": {"inflow": 4, "desiredOut": 12, "protectBelow": 25} },
    { "label": "Supply > demand", "params": {"inflow": 12, "desiredOut": 6, "protectBelow": 25} }
  ]
}
