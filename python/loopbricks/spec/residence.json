{
  "format": "loopbricks-model",
  "version": 1,
  "key": "residence",
  "title": "Residence Time",
  "description": "A stock fed by a steady inflow and drained in proportion to itself settles where inflow balances outflow, and the average time a unit stays is τ.",
  "model": {
    "name": "Residence Time",
    "timeUnit": "month",
    "T": 60,
    "dt": 0.1,
    "stocks": [
      { "id": "q", "name": "In service", "init": "0", "x": 395, "y": 150, "nonNegative": true }
    ],
    "flows": [
      { "id": "in", "name": "Entering", "to": "q", "eq": "Inflow", "x": 185, "y": 150 },
      { "id": "out", "name": "Outflow", "from": "q", "eq": "In_service / Avg_residence_time", "x": 623, "y": 150 }
    ],
    "vars": [
      { "id": "inflow", "name": "Inflow", "eq": "8", "x": 80, "y": 260 },
      { "id": "tau", "name": "Avg residence time", "eq": "5", "x": 250, "y": 320 }
    ]
  },
  "params": {
    "inflow": { "min": 0, "max": 20, "step": 0.5 },
    "tau": { "min": 1, "max": 12, "step": 0.5 }
  },
  "presets": [
    { "label": "Short stay", "params": {"inflow": 8, "tau": 2} },
    { "label": "Long stay", "params": {"inflow": 8, "tau": 10} }
  ]
}
