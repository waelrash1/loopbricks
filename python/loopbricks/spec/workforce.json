{
  "format": "loopbricks-model",
  "version": 1,
  "key": "workforce",
  "title": "Workforce (Hiring & Firing)",
  "description": "Move the workforce toward a desired level by hiring or firing, but the adjustment takes time, so the actual workforce always trails the target.",
  "model": {
    "name": "Workforce",
    "timeUnit": "year",
    "T": 60,
    "dt": 0.1,
    "stocks": [
      {
        "id": "workforce",
        "name": "Workforce",
        "init": "40",
        "x": 395,
        "y": 150,
        "nonNegative": true
      }
    ],
    "flows": [
      {
        "id": "hiring",
        "name": "Hiring",
        "to": "workforce",
        "eq": "MAX(0, Workforce_adjustment)",
        "x": 185,
        "y": 150
      },
      {
        "id": "firing",
        "name": "Firing",
        "from": "workforce",
        "eq": "MAX(0, -Workforce_adjustment)",
        "x": 623,
        "y": 150
      }
    ],
    "vars": [
      {
        "id": "desired",
        "name": "Desired workforce",
        "eq": "60",
        "x": 100,
        "y": 300
      },
      {
        "id": "tHire",
        "name": "Time to hire or fire",
        "eq": "4",
        "x": 260,
        "y": 300
      },
      {
        "id": "adjust",
        "name": "Workforce adjustment",
        "eq": "(Desired_workforce - Workforce) / Time_to_hire_or_fire",
        "x": 420,
        "y": 300
      }
    ]
  },
  "params": {
    "desired": {
      "min": 0,
      "max": 100,
      "step": 1
    },
    "tHire": {
      "min": 0.5,
      "max": 12,
      "step": 0.5
    }
  },
  "presets": [
    {
      "label": "Ramp up",
      "params": {
        "desired": 80,
        "tHire": 4
      }
    },
    {
      "label": "Downsize",
      "params": {
        "desired": 20,
        "tHire": 4
      }
    }
  ]
}
