{
  "format": "loopbricks-model",
  "version": 1,
  "key": "effectFatigue",
  "title": "Effect of Fatigue",
  "description": "Fatigue is a smooth of overtime, measured in the same units as overtime. A function of fatigue then gives its effect on productivity (or quality).",
  "model": {
    "name": "Effect of Fatigue",
    "timeUnit": "month",
    "T": 60,
    "dt": 0.1,
    "stocks": [
      {"id":"fatigue","name":"Fatigue","init":"1","x":410,"y":150,"nonNegative":true},
      {"id":"effect","name":"Effect on PDY","init":"Effect_of_fatigue_on_PDY","x":560,"y":330,"nonNegative":true}
    ],
    "flows": [
      {"id":"gettingFatigued","name":"Getting fatigued","to":"fatigue","eq":"MAX(0, Net_fatigue_change)","x":193,"y":150},
      {"id":"recovering","name":"Recovering","from":"fatigue","eq":"MAX(0, -Net_fatigue_change)","x":630,"y":150},
      {"id":"track_effect","name":"Tracking effect","to":"effect","eq":"(Effect_of_fatigue_on_PDY - Effect_on_PDY) / DT","x":450,"y":330}
    ],
    "vars": [
      {"id":"overtime","name":"Overtime","eq":"1.5","x":80,"y":420},
      {"id":"timeToFatigue","name":"Time to get fatigued","eq":"3","units":"month","x":220,"y":420},
      {"id":"slope","name":"Strength of effect","eq":"0.6","x":360,"y":420},
      {"id":"net","name":"Net fatigue change","eq":"(Overtime - Fatigue) / Time_to_get_fatigued","x":500,"y":420},
      {"id":"effectF","name":"Effect of fatigue on PDY","eq":"MAX(0, MIN(1.2, 1 - Strength_of_effect * (Fatigue - 1)))","x":640,"y":420}
    ]
  },
  "params": {
    "overtime": {"min":0.5,"max":2,"step":0.05},
    "timeToFatigue": {"min":0.5,"max":12,"step":0.5},
    "slope": {"min":0,"max":1,"step":0.05}
  },
  "presets": [
    {"label":"Sustained crunch","params":{"overtime":1.5,"timeToFatigue":3,"slope":0.6}},
    {"label":"Slow to tire","params":{"overtime":1.5,"timeToFatigue":10,"slope":0.6}},
    {"label":"Short weeks (rested)","params":{"overtime":0.7,"timeToFatigue":3,"slope":0.6}}
  ]
}
