{
  "format": "loopbricks-model",
  "version": 1,
  "key": "seaAnchor",
  "title": "Sea Anchor & Adjustment",
  "description": "Judge a value relative to a slowly-drifting anchor, but if the anchor chases the value it produces, expectations become self-fulfilling and drift without limit.",
  "model": {
    "name": "Sea Anchor & Adjustment",
    "timeUnit": "month",
    "T": 60,
    "dt": 0.1,
    "stocks": [
      {
        "id": "anchor",
        "name": "Anchor",
        "init": "100",
        "x": 395,
        "y": 150
      }
    ],
    "flows": [
      {
        "id": "changeAnchor",
        "name": "Change anchor",
        "to": "anchor",
        "eq": "(Produced_value - Anchor) / Anchor_lag",
        "x": 185,
        "y": 150
      }
    ],
    "vars": [
      {
        "id": "pressure",
        "name": "Adjustment pressure",
        "eq": "1",
        "x": 100,
        "y": 420
      },
      {
        "id": "timeToChange",
        "name": "Anchor lag",
        "eq": "6",
        "x": 260,
        "y": 420
      },
      {
        "id": "value",
        "name": "Produced value",
        "eq": "Anchor * Adjustment_pressure",
        "x": 420,
        "y": 420
      },
      {
        "id": "valueDisp",
        "name": "Value",
        "eq": "Produced_value",
        "x": 160,
        "y": 300
      }
    ]
  },
  "params": {
    "pressure": {
      "min": 0.5,
      "max": 2,
      "step": 0.05
    },
    "timeToChange": {
      "min": 1,
      "max": 24,
      "step": 1
    }
  },
  "presets": [
    {
      "label": "Stable",
      "params": {
        "pressure": 1,
        "timeToChange": 6
      }
    },
    {
      "label": "Runaway drift",
      "params": {
        "pressure": 1.2,
        "timeToChange": 6
      }
    }
  ]
}
