{
  "format": "loopbricks-model",
  "version": 1,
  "key": "abilityFromAction",
  "title": "Ability from Action (Implied Productivity)",
  "description": "If you can see the flow and count the resources producing it, their ability is simply flow ÷ resource. The same relation as Action from Resource, read backwards.",
  "model": {
    "name": "Ability from Action",
    "timeUnit": "month",
    "T": 60,
    "dt": 0.1,
    "stocks": [
      {"id":"ability","name":"Measured ability","init":"2","x":410,"y":150}
    ],
    "flows": [
      {"id":"up","name":"Revising up","to":"ability","eq":"MAX(0, Ability_adjustment)","x":193,"y":150},
      {"id":"down","name":"Revising down","from":"ability","eq":"MAX(0, -Ability_adjustment)","x":630,"y":150}
    ],
    "vars": [
      {"id":"flow","name":"Flow","eq":"60","units":"/month","x":80,"y":340},
      {"id":"resource","name":"Resource","eq":"10","x":220,"y":340},
      {"id":"measureTime","name":"Measuring time","eq":"2","units":"month","x":360,"y":340},
      {"id":"implied","name":"Ability","eq":"Flow / MAX(Resource, 0.000001)","x":500,"y":340},
      {"id":"adjust","name":"Ability adjustment","eq":"(Ability - Measured_ability) / Measuring_time","x":640,"y":340}
    ]
  },
  "params": {
    "flow": {"min":0,"max":120,"step":5},
    "resource": {"min":1,"max":30,"step":1},
    "measureTime": {"min":0.5,"max":8,"step":0.5}
  },
  "presets": [
    {"label":"10 resources","params":{"flow":60,"resource":10,"measureTime":2}},
    {"label":"Same flow, 20 resources","params":{"flow":60,"resource":20,"measureTime":2}},
    {"label":"Double the flow","params":{"flow":120,"resource":10,"measureTime":2}}
  ]
}
