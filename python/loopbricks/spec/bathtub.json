{
  "format": "loopbricks-model",
  "version": 1,
  "key": "bathtub",
  "title": "Bathtub",
  "description": "One stock filled by an inflow and drained by an outflow. The outflow stops when the stock is empty.",
  "model": {
    "name": "Bathtub",
    "timeUnit": "year",
    "T": 60,
    "dt": 0.1,
    "stocks": [{ "id": "level", "name": "Level", "init": "50", "x": 380, "y": 200, "units": "units", "nonNegative": true }],
    "flows": [
      { "id": "in", "name": "Filling", "to": "level", "eq": "Inflow", "x": 220, "y": 200, "units": "units/year" },
      { "id": "out", "name": "Draining", "from": "level", "eq": "MIN(Outflow, Level / DT + Inflow)", "x": 540, "y": 200, "units": "units/year" }
    ],
    "vars": [
      { "id": "inflow", "name": "Inflow", "eq": "10", "x": 220, "y": 90, "units": "units/year" },
      { "id": "outflow", "name": "Outflow", "eq": "8", "x": 540, "y": 90, "units": "units/year" }
    ]
  },
  "params": {
    "inflow": { "min": 0, "max": 30, "step": 0.5 },
    "outflow": { "min": 0, "max": 30, "step": 0.5 }
  },
  "presets": [
    { "label": "Filling", "params": { "inflow": 14, "outflow": 6 } },
    { "label": "Draining", "params": { "inflow": 3, "outflow": 12 } },
    { "label": "Steady state", "params": { "inflow": 8, "outflow": 8 } }
  ]
}
