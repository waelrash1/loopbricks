{
  "format": "loopbricks-model",
  "version": 1,
  "key": "cascade",
  "title": "Cascaded Levels (Chain)",
  "description": "Material accumulates at several points in series; each stage drains into the next with a delay. This is how time-lags are built.",
  "model": {
    "name": "Cascaded Levels",
    "timeUnit": "month",
    "T": 60,
    "dt": 0.1,
    "stocks": [
      { "id": "l1", "name": "Stage 1", "init": "60", "x": 170, "y": 155, "nonNegative": true },
      { "id": "l2", "name": "Stage 2", "init": "0", "x": 410, "y": 155, "nonNegative": true },
      { "id": "l3", "name": "Stage 3", "init": "0", "x": 650, "y": 155, "nonNegative": true }
    ],
    "flows": [
      { "id": "in", "name": "Entering", "to": "l1", "eq": "Inflow", "x": 70, "y": 155 },
      { "id": "f12", "name": "Flow 1 to 2", "from": "l1", "to": "l2", "eq": "Stage_1 / Stage_delay", "x": 290, "y": 155 },
      { "id": "f23", "name": "Flow 2 to 3", "from": "l2", "to": "l3", "eq": "Stage_2 / Stage_delay", "x": 530, "y": 155 },
      { "id": "out", "name": "Outflow", "from": "l3", "eq": "Stage_3 / Stage_delay", "x": 750, "y": 155 }
    ],
    "vars": [
      { "id": "inflow", "name": "Inflow", "eq": "0", "x": 80, "y": 265 },
      { "id": "tau", "name": "Stage delay", "eq": "4", "x": 250, "y": 325 }
    ]
  },
  "params": {
    "inflow": { "min": 0, "max": 20, "step": 0.5 },
    "tau": { "min": 1, "max": 12, "step": 0.5 }
  },
  "presets": [
    { "label": "Pulse through", "params": {"inflow": 0, "tau": 4} },
    { "label": "Steady inflow", "params": {"inflow": 10, "tau": 4} },
    { "label": "Fast (low τ)", "params": {"inflow": 10, "tau": 1.5} }
  ]
}
