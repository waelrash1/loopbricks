{
  "format": "loopbricks-model",
  "version": 1,
  "key": "protByPDY",
  "title": "Level Protected by PDY (Productivity)",
  "description": "Stop workers draining a backlog below zero by letting their productivity fall as the work runs thin: no tasks left means nothing to be productive on.",
  "model": {
    "name": "Level Protected by PDY",
    "timeUnit": "month",
    "T": 60,
    "dt": 0.1,
    "stocks": [
      {"id":"remaining","name":"Remaining work","init":"300","x":395,"y":150,"nonNegative":true}
    ],
    "flows": [
      {"id":"in","name":"Arriving work","to":"remaining","eq":"New_work","x":185,"y":150},
      {"id":"producing","name":"Producing","from":"remaining","eq":"Workers * Productivity","x":623,"y":150}
    ],
    "vars": [
      {"id":"workers","name":"Workers","eq":"10","units":"people","x":80,"y":340},
      {"id":"normalPDY","name":"Normal PDY","eq":"5","units":"/p·month","x":220,"y":340},
      {"id":"required","name":"Work for full PDY","eq":"60","units":"tasks","x":360,"y":340},
      {"id":"newWork","name":"New work","eq":"0","units":"/month","x":500,"y":340},
      {"id":"relative","name":"Relative remaining work","eq":"Remaining_work / MAX(Work_for_full_PDY, 0.000001)","x":640,"y":340},
      {"id":"pdy","name":"Productivity","eq":"Normal_PDY * MAX(0, MIN(1, Relative_remaining_work))","x":780,"y":340}
    ]
  },
  "params": {
    "workers": {"min":0,"max":20,"step":1},
    "normalPDY": {"min":1,"max":10,"step":0.5},
    "required": {"min":20,"max":150,"step":5},
    "newWork": {"min":0,"max":60,"step":1}
  },
  "presets": [
    {"label":"Run the backlog down","params":{"workers":10,"normalPDY":5,"required":60,"newWork":0}},
    {"label":"Steady new work","params":{"workers":10,"normalPDY":5,"required":60,"newWork":20}},
    {"label":"Early taper","params":{"workers":10,"normalPDY":5,"required":150,"newWork":0}}
  ]
}
