{
  "format": "loopbricks-model",
  "version": 1,
  "key": "protFlow",
  "title": "Level Protected by Flow",
  "description": "Cap the outflow at the most the stock can physically supply: you cannot drain faster than Level ÷ fastest-draining-time, so it never goes negative.",
  "model": {
    "name": "Level Protected by Flow",
    "timeUnit": "week",
    "T": 60,
    "dt": 0.1,
    "stocks": [
      { "id": "level", "name": "On hand", "init": "80", "x": 395, "y": 150, "nonNegative": true }
    ],
    "flows": [
      { "id": "in", "name": "Replenish", "to": "level", "eq": "Replenishment", "x": 185, "y": 150 },
      { "id": "out", "name": "Draining", "from": "level", "eq": "MIN(Desired_draining, On_hand / Fastest_draining_time)", "x": 623, "y": 150 }
    ],
    "vars": [
      { "id": "inflow", "name": "Replenishment", "eq": "3", "x": 80, "y": 260 },
      { "id": "desiredOut", "name": "Desired draining", "eq": "10", "x": 250, "y": 320 },
      { "id": "fastest", "name": "Fastest draining time", "eq": "2", "x": 420, "y": 260 }
    ]
  },
  "params": {
    "inflow": { "min": 0, "max": 15, "step": 0.5 },
    "desiredOut": { "min": 0, "max": 25, "step": 0.5 },
    "fastest": { "min": 0.5, "max": 6, "step": 0.5 }
  },
  "presets": [
    { "label": "Drain to limit", "params": {"inflow": 3, "desiredOut": 10, "fastest": 2} },
    { "label": "Slow extraction", "params": {"inflow": 3, "desiredOut": 10, "fastest": 5} }
  ]
}
