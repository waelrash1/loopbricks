{
  "format": "loopbricks-model",
  "version": 1,
  "key": "overtime",
  "title": "Overtime (Required Overtime)",
  "description": "Indicated overtime is the number of workers we wish we had divided by the number we actually have. A limiting function turns it into the overtime people will really work.",
  "model": {
    "name": "Overtime",
    "timeUnit": "week",
    "T": 60,
    "dt": 0.1,
    "stocks": [
      {"id":"done","name":"Work accomplished","init":"0","x":410,"y":85,"nonNegative":true},
      {"id":"shortfall","name":"Work fallen behind","init":"0","x":410,"y":205,"nonNegative":true},
      {"id":"ot","name":"Overtime shown","init":"Overtime","x":560,"y":330,"nonNegative":true}
    ],
    "flows": [
      {"id":"accomplishing","name":"Accomplishing","to":"done","eq":"Workers * Productivity * Overtime","x":193,"y":85},
      {"id":"fallingBehind","name":"Falling behind","to":"shortfall","eq":"MAX(0, Desired_accomplishing_rate - Accomplishing)","x":193,"y":205},
      {"id":"track_ot","name":"Tracking overtime","to":"ot","eq":"(Overtime - Overtime_shown) / DT","x":450,"y":330}
    ],
    "vars": [
      {"id":"desiredRate","name":"Desired accomplishing rate","eq":"60","units":"/week","x":80,"y":420},
      {"id":"productivity","name":"Productivity","eq":"4","units":"/p·week","x":220,"y":420},
      {"id":"workers","name":"Workers","eq":"10","units":"people","x":360,"y":420},
      {"id":"maxOvertime","name":"Overtime limit","eq":"1.3","x":500,"y":420},
      {"id":"desiredPeople","name":"Desired people","eq":"Desired_accomplishing_rate / MAX(Productivity, 0.000001)","x":640,"y":420},
      {"id":"indicated","name":"Indicated overtime","eq":"Desired_people / MAX(Workers, 0.000001)","x":780,"y":420},
      {"id":"overtimeV","name":"Overtime","eq":"MIN(Overtime_limit, Indicated_overtime)","x":80,"y":500}
    ]
  },
  "params": {
    "desiredRate": {"min":0,"max":150,"step":5},
    "productivity": {"min":1,"max":10,"step":0.5},
    "workers": {"min":0,"max":30,"step":1},
    "maxOvertime": {"min":1,"max":2,"step":0.05}
  },
  "presets": [
    {"label":"Capped by the limit","params":{"desiredRate":60,"productivity":4,"workers":10,"maxOvertime":1.3}},
    {"label":"Enough people","params":{"desiredRate":60,"productivity":4,"workers":15,"maxOvertime":1.3}},
    {"label":"Productivity slips","params":{"desiredRate":60,"productivity":3,"workers":10,"maxOvertime":1.3}}
  ]
}
